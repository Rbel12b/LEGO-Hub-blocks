"""Minimal Python builtins stub.

Pyright ships its own `builtins`, but the in-browser stub-driven LSP has no
default typeshed, so we vendor the common surface here. Only names that show
up in casual scripts. Add more as they're missed.
"""
from typing import Any, Callable, Iterable, Iterator, Sequence, Sized

# ── Type-check / introspection ──────────────────────────────────────────────

def isinstance(obj: Any, classinfo: Any) -> bool:
    """Return True if obj is an instance of classinfo (or a tuple thereof)."""
    ...

def issubclass(cls: Any, classinfo: Any) -> bool: ...
def type(obj: Any) -> Any: ...
def callable(obj: Any) -> bool: ...
def id(obj: Any) -> int: ...
def hash(obj: Any) -> int: ...
def repr(obj: Any) -> str: ...
def dir(obj: Any = ...) -> list[str]: ...
def vars(obj: Any = ...) -> dict[str, Any]: ...
def getattr(obj: Any, name: str, default: Any = ...) -> Any: ...
def setattr(obj: Any, name: str, value: Any) -> None: ...
def hasattr(obj: Any, name: str) -> bool: ...
def delattr(obj: Any, name: str) -> None: ...

# ── I/O ─────────────────────────────────────────────────────────────────────

def print(*values: Any, sep: str = " ", end: str = "\n", file: Any = ..., flush: bool = False) -> None:
    """Print values to a stream, or to sys.stdout by default."""
    ...

def input(prompt: str = "") -> str: ...
def open(file: str, mode: str = "r", *args: Any, **kwargs: Any) -> Any: ...

