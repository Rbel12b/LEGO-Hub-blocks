def sorted(iterable: Iterable[Any], key: Callable[[Any], Any] = ..., reverse: bool = False) -> list[Any]: ...
def reversed(seq: Sequence[Any]) -> Iterator[Any]: ...
def all(iterable: Iterable[Any]) -> bool: ...
def any(iterable: Iterable[Any]) -> bool: ...

# ── String / bytes ──────────────────────────────────────────────────────────

def chr(i: int) -> str: ...
def ord(c: str) -> int: ...
def hex(x: int) -> str: ...
def bin(x: int) -> str: ...
def oct(x: int) -> str: ...
def format(value: Any, spec: str = "") -> str: ...
def ascii(obj: Any) -> str: ...

# ── Types (constructors) ────────────────────────────────────────────────────

class object:
    def __init__(self) -> None: ...

class int:
    def __init__(self, x: Any = ..., base: int = ...) -> None: ...
    def bit_length(self) -> int: ...
    def to_bytes(self, length: int, byteorder: str = "big") -> bytes: ...

class float:
    def __init__(self, x: Any = ...) -> None: ...
    def is_integer(self) -> bool: ...

class bool:
    def __init__(self, x: Any = ...) -> None: ...

class str:
    def __init__(self, obj: Any = ..., encoding: str = ..., errors: str = ...) -> None: ...
    def upper(self) -> str: ...
    def lower(self) -> str: ...
    def strip(self, chars: str = ...) -> str: ...
    def lstrip(self, chars: str = ...) -> str: ...
    def rstrip(self, chars: str = ...) -> str: ...
    def split(self, sep: str = ..., maxsplit: int = ...) -> list[str]: ...
    def join(self, iterable: Iterable[str]) -> str: ...
    def replace(self, old: str, new: str, count: int = ...) -> str: ...
    def startswith(self, prefix: str) -> bool: ...
    def endswith(self, suffix: str) -> bool: ...
    def find(self, sub: str) -> int: ...
    def index(self, sub: str) -> int: ...
    def format(self, *args: Any, **kwargs: Any) -> str: ...
    def encode(self, encoding: str = "utf-8", errors: str = "strict") -> bytes: ...

class bytes:
    def __init__(self, source: Any = ..., encoding: str = ..., errors: str = ...) -> None: ...
    def decode(self, encoding: str = "utf-8", errors: str = "strict") -> str: ...
    def hex(self) -> str: ...

class bytearray:
    def __init__(self, source: Any = ..., encoding: str = ..., errors: str = ...) -> None: ...

class list:
    def append(self, obj: Any) -> None: ...
    def extend(self, iterable: Iterable[Any]) -> None: ...
    def insert(self, index: int, obj: Any) -> None: ...
    def remove(self, value: Any) -> None: ...
    def pop(self, index: int = -1) -> Any: ...
    def clear(self) -> None: ...
    def index(self, value: Any) -> int: ...
    def count(self, value: Any) -> int: ...
    def sort(self, key: Callable[[Any], Any] = ..., reverse: bool = False) -> None: ...
    def reverse(self) -> None: ...
    def copy(self) -> list: ...

class tuple:
    def index(self, value: Any) -> int: ...
    def count(self, value: Any) -> int: ...

class dict:
    def keys(self) -> Iterable[Any]: ...
    def values(self) -> Iterable[Any]: ...
    def items(self) -> Iterable[tuple[Any, Any]]: ...
    def get(self, key: Any, default: Any = ...) -> Any: ...
    def pop(self, key: Any, default: Any = ...) -> Any: ...
    def update(self, other: Any) -> None: ...
    def clear(self) -> None: ...
    def copy(self) -> dict: ...
    def setdefault(self, key: Any, default: Any = ...) -> Any: ...

class set:
    def add(self, elem: Any) -> None: ...
    def remove(self, elem: Any) -> None: ...
    def discard(self, elem: Any) -> None: ...
    def pop(self) -> Any: ...
    def clear(self) -> None: ...
    def union(self, *others: Iterable[Any]) -> set: ...
    def intersection(self, *others: Iterable[Any]) -> set: ...
    def difference(self, *others: Iterable[Any]) -> set: ...

class frozenset:
    def union(self, *others: Iterable[Any]) -> frozenset: ...

# ── Exceptions (subset) ─────────────────────────────────────────────────────

class BaseException:
    args: tuple

class Exception(BaseException): ...
class ValueError(Exception): ...
class TypeError(Exception): ...
class KeyError(Exception): ...
class IndexError(Exception): ...
class AttributeError(Exception): ...
class RuntimeError(Exception): ...
class StopIteration(Exception): ...
class KeyboardInterrupt(BaseException): ...
class MemoryError(Exception): ...
class OSError(Exception): ...
class NotImplementedError(RuntimeError): ...
class ZeroDivisionError(Exception): ...

