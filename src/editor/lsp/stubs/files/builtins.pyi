def abs(x: Any) -> Any: ...
def divmod(a: Any, b: Any) -> tuple[Any, Any]: ...
def pow(base: Any, exp: Any, mod: Any = ...) -> Any: ...
def round(number: Any, ndigits: int = ...) -> Any: ...
def min(*args: Any, key: Callable[[Any], Any] = ..., default: Any = ...) -> Any: ...
def max(*args: Any, key: Callable[[Any], Any] = ..., default: Any = ...) -> Any: ...
def sum(iterable: Iterable[Any], start: Any = 0) -> Any: ...

# ── Iteration ───────────────────────────────────────────────────────────────

def len(obj: Sized) -> int: ...
def iter(obj: Any, sentinel: Any = ...) -> Iterator[Any]: ...
def next(iterator: Iterator[Any], default: Any = ...) -> Any: ...
def range(start: int, stop: int = ..., step: int = ...) -> Sequence[int]: ...
def enumerate(iterable: Iterable[Any], start: int = 0) -> Iterator[tuple[int, Any]]: ...
def zip(*iterables: Iterable[Any]) -> Iterator[tuple[Any, ...]]: ...
